ALPHA_VANTAGE_API_KEY=your_key_here

# Gemini Enterprise Agent Platform (src/agents/llm_client.py).
# Auth is via Application Default Credentials, NOT a token in this file —
# run `gcloud auth application-default login` locally, or use workload
# identity / a mounted service account in containers.
GCP_PROJECT_ID=your-gcp-project-id
# us-central1 confirmed available for this model — check the model's page
# in Vertex AI Model Garden before changing this.
GCP_LOCATION=us-central1
# Optional, defaults to meta/llama-3.3-70b-instruct-maas — see
# src/agents/llm_client.py for why this model was chosen.
# LLM_MODEL_VERSION=meta/llama-3.3-70b-instruct-maas

# Embeddings for article_summaries (src/retriever/embeddings.py). Same
# project, location and ADC auth as above. Optional, defaults shown.
# EMBEDDING_MODEL=text-embedding-005
# EMBEDDING_BATCH_SIZE=50